{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "StartPlantUML",
            "type": "shell",
            "command": "java",
            "args": [
                "-jar",
                "${env:LOCALAPPDATA}\\Programs\\PlantUML\\plantuml.jar",
                "-picoweb:8008",
                "-tsvg",
                "-verbose"
            ],
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}